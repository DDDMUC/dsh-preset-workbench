{
  "name": "dsh-preset-workbench",
  "version": "0.2.1",
  "description": "预设工作台：在设置页自己创建/编辑 agent 预设提示词（分段+可见性开关+打开目录），并把你磁盘上的用户预设声明给 DSH 预设注册表。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/yaml-lite.js",
    "cordis.patch.yml",
    "templates"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDMUC/dsh-preset-workbench.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "dsh",
    "preset",
    "workbench",
    "agent-preset",
    "settings-ui"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
